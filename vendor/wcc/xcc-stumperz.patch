diff --git a/libsrc/_wasm/unistd/open.c b/libsrc/_wasm/unistd/open.c
index ee511aa..39e9fc6 100644
--- a/libsrc/_wasm/unistd/open.c
+++ b/libsrc/_wasm/unistd/open.c
@@ -14,12 +14,15 @@ typedef struct {
   uint32_t fdflags;
   uint64_t fs_rights_inheriting;
   uint32_t opened;
+  uint32_t last_error;
 } OpenData;
 
 static bool search_open(int base_fd, const char *fn, size_t fnlen, void *data) {
   OpenData *od = (OpenData*)data;
   uint32_t result = path_open(base_fd, od->dirflags, fn, fnlen, od->oflags, od->fs_rights_base,
                               od->fs_rights_inheriting, od->fdflags, &od->opened);
+  if (result != 0 && (od->last_error == 0 || od->last_error == 44))
+    od->last_error = result;
   return result == 0;
 }
 
@@ -29,6 +32,7 @@ int open(const char *fn, int flag, ...) {
   od.oflags = 0;
   od.fs_rights_base = 0;
   od.fdflags = 0; //FDFLAGS_RSYNC;
+  od.last_error = 0;
   switch (flag & O_ACCMODE) {
   case O_RDONLY:
     od.fs_rights_base =
@@ -74,6 +78,13 @@ int open(const char *fn, int flag, ...) {
   if (_search_preopen(fn, &od, search_open))
     return od.opened;
 
-  errno = ENOENT;  // (flag & O_CREAT) ? EEXIST, or something.
+  // Map the WASI error code to the POSIX errno value.
+  switch (od.last_error) {
+  case 2:  errno = EACCES; break;
+  case 20: errno = EEXIST; break;
+  case 31: errno = EISDIR; break;
+  case 54: errno = ENOTDIR; break;
+  default: errno = ENOENT; break;
+  }
   return -1;
 }
